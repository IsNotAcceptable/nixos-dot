# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot = {
    initrd = {
      availableKernelModules = [ "xhci_pci" "ahci" "nvme" "usb_storage" "sd_mod" ];
      kernelModules = [ ];
    };
    kernel = {
      sysctl = {
	"vm.swappiness" = 10;
	"vm.vfs_cache_pressure" = 50;
	"net.core.default_gdisc" = "fq";
	"net.ipv4.tcp_congestion_control" = "bbr";
      };
    };
    kernelModules = [ "kvm-intel" "tcp_bbr" ];
    kernelPackages = pkgs.linuxPackages_latest;
    extraModulePackages = [ 
      config.boot.kernelPackages.amneziawg
    ];

    loader = {
      systemd-boot.enable = true;
      efi.canTouchEfiVariables = true;
    };

    resumeDevice = "/dev/disk/by-uuid/9814a81f-72ac-494d-ad31-06c10f242e36";

    enableContainers = true;

    tmp = {
      cleanOnBoot = true;
      useTmpfs = true;
      tmpfsSize = "50%";
    };
  };

  zramSwap = {
    enable = true;
    priority = 100;
  };

  hardware = {
    enableAllFirmware = true;
    bluetooth = {
      enable = true;
      powerOnBoot = true;
    };

    graphics = {
      enable = true;
      extraPackages = with pkgs; [
        intel-media-driver
	libva-vdpau-driver libvdpau-va-gl
      ];
    };

  };

  powerManagement.cpuFreqGovernor = lib.mkDefault "powersave";

  fileSystems."/" =
    { device = "/dev/disk/by-uuid/d852686e-4236-450a-8174-9514440e5191";
      fsType = "btrfs";
      options = [ "subvol=@" "noatime" "compress=zstd:1" "ssd" "space_cache=v2" "discard=async" ];
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/7849-4093";
      fsType = "vfat";
      options = [ "fmask=0022" "dmask=0022" ];
    };

  fileSystems."/home" =
    { device = "/dev/disk/by-uuid/d852686e-4236-450a-8174-9514440e5191";
      fsType = "btrfs";
      options = [ "subvol=@home" "noatime" "compress=zstd" ];
    };

  fileSystems."/nix" =
    { device = "/dev/disk/by-uuid/d852686e-4236-450a-8174-9514440e5191";
      fsType = "btrfs";
      options = [ "subvol=@nix" "noatime" "compress=zstd" ];
    };

  fileSystems."/var/log" =
    { device = "/dev/disk/by-uuid/d852686e-4236-450a-8174-9514440e5191";
      fsType = "btrfs";
      options = [ "subvol=@log" "noatime" ];
    };

  swapDevices =
    [ { device = "/dev/disk/by-uuid/9814a81f-72ac-494d-ad31-06c10f242e36"; }
    ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
